@*
    File: Index.cshtml
    Folder: Views/Items
    Project: HomeInsurance-MVC
    Author(s): Julia Jakob
    Date: 2026-04-11
    Description:
    This view displays the list of inventory items stored in the system.
    It allows the user to view the current records and navigate to other
    item operations such as Create, Edit, Details, and Delete.
*@

@model List<Item>

@{
    ViewData["Title"] = "My Items";
}

<div class="container mt-4">
    <div class="row mb-4 items-header">
        <div class="col-md-8">
            <h1>My Home Inventory</h1>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" asp-controller="Items" class="btn items-add-btn">
                <i class="bi bi-plus-circle"></i> Add New Item
            </a>
        </div>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="items-empty-alert">
            <p>No items in inventory yet, <a asp-action="Create" asp-controller="Items">add an item!</a></p>
        </div>
    }
    else
    {
        <div class="table-responsive items-table">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Value</th>
                        <th>Purchase Date</th>
                        <th>Serial #</th>
                        <th>Description</th>
                        <th>Date Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Where(i => !i.IsDeleted))
                    {
                        <tr>
                            <td><strong>@item.ItemName</strong></td>

                            <td>
                                <span class="badge">@item.Category</span>
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.RoomLocation) ? "—" : item.RoomLocation)
                            </td>

                            <td>
                                $@item.EstimatedValue.ToString("F2")
                            </td>

                            <td>
                                @(item.PurchaseDate?.ToString("MM/dd/yyyy") ?? "—")
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.SerialNumber) ? "—" : item.SerialNumber)
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                            </td>

                            <td>
                                @item.CreatedDate.ToString("MM/dd/yyyy")
                            </td>

                            <td>
                                <a asp-action="Details" asp-route-id="@item.ItemID" class="btn btn-sm btn-info items-action-btn">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@item.ItemID" class="btn btn-sm btn-warning items-action-btn">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.ItemID" class="btn btn-sm btn-danger items-action-btn">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row items-footer">
            <div class="col-12">
                <p>Total Items: <strong>@Model.Count(i => !i.IsDeleted)</strong></p>
            </div>
        </div>
    }
</div>