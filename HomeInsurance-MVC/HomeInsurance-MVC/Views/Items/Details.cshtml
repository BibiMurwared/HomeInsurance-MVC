@*
    File: Details.cshtml
    Folder: Views/Items
    Project: HomeInsurance-MVC
    Author(s): Julia Jakob
    Date: 2026-04-11
    Description:
    This view displays the complete details of a selected inventory item.
    It is used when the user wants to view a single record in full.
*@
@model HomeInsurance_MVC.Models.Item

@{
    ViewData["Title"] = "Item Details";
}

<div class="container mt-4">
    <div class="items-header">
        <h1>Item Details</h1>
    </div>

    <div class="card p-4 shadow-sm" style="border-radius: 10px;">

        <div class="row mb-3">
            <div class="col-md-6">
                <h5 class="text-muted">Item Name</h5>
                <p class="fw-bold">@Model.ItemName</p>
            </div>

            <div class="col-md-6">
                <h5 class="text-muted">Category</h5>
                <span class="badge">@Model.Category</span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <h5 class="text-muted">Estimated Value</h5>
                <p>$@Model.EstimatedValue.ToString("F2")</p>
            </div>

            <div class="col-md-6">
                <h5 class="text-muted">Purchase Date</h5>
                <p>@(Model.PurchaseDate?.ToString("MM/dd/yyyy") ?? "—")</p>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <h5 class="text-muted">Room Location</h5>
                <p>@(string.IsNullOrEmpty(Model.RoomLocation) ? "—" : Model.RoomLocation)</p>
            </div>

            <div class="col-md-6">
                <h5 class="text-muted">Serial Number</h5>
                <p>@(string.IsNullOrEmpty(Model.SerialNumber) ? "—" : Model.SerialNumber)</p>
            </div>
        </div>

        <div class="mb-3">
            <h5 class="text-muted">Description</h5>
            <p>@(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)</p>
        </div>

        <div class="mb-3">
            <h5 class="text-muted">Created Date</h5>
            <p>@Model.CreatedDate.ToString("MM/dd/yyyy")</p>
        </div>

        <!-- Buttons -->
        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">Back</a>

            <div>
                <a asp-action="Edit" asp-route-id="@Model.ItemID" class="btn btn-warning items-action-btn">
                    Edit
                </a>

                <a asp-action="Delete" asp-route-id="@Model.ItemID" class="btn btn-danger items-action-btn">
                    Delete
                </a>
            </div>
        </div>

    </div>
</div>