@*
    File: Delete.cshtml
    Folder: Views/Items
    Project: HomeInsurance-MVC
    Author(s): Julia Jakob
    Date: 2026-04-11
    Description:
    This view displays a confirmation page before deleting an inventory item.
    It allows the user to review the item and confirm the deletion action.
*@
@model HomeInsurance_MVC.Models.Item

@{
    ViewData["Title"] = "Delete Item";
}

<div class="container mt-4">
    <div class="items-header">
        <h1>Delete Item</h1>
    </div>

    <div class="card p-4 shadow-sm" style="border-radius: 10px;">

        <div class="alert" style="background-color:#F8D7DA; color:#842029; border-radius:8px;">
            <strong>Warning:</strong> Are you sure you want to delete this item?
        </div>

        <div class="mb-3">
            <h5 class="text-muted">Item Name</h5>
            <p class="fw-bold">@Model.ItemName</p>
        </div>

        <div class="mb-3">
            <h5 class="text-muted">Category</h5>
            <p>@Model.Category</p>
        </div>

        <div class="mb-3">
            <h5 class="text-muted">Estimated Value</h5>
            <p>$@Model.EstimatedValue.ToString("F2")</p>
        </div>

        <div class="mb-3">
            <h5 class="text-muted">Location</h5>
            <p>@(string.IsNullOrEmpty(Model.RoomLocation) ? "—" : Model.RoomLocation)</p>
        </div>

        <!-- FORM -->
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="ItemID" />

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>

                <button type="submit" class="btn btn-danger items-action-btn">
                    Delete
                </button>
            </div>
        </form>

    </div>
</div>